# Local hub (the box on the restaurant Wi-Fi). Copy to apps/hub/.env on the hub machine.

# From Manage → Devices → "Set up hub" (the token is shown once)
CLOUD_URL=https://api.example.com
HUB_TOKEN=

# Port staff devices reach the hub on (must match the hub address entered in Manage → Devices)
HUB_PORT=4100
# Where queued work is kept so it survives a reboot
HUB_DATA_FILE=./hub-data/state.json
# Console origin(s) allowed to call the hub from the browser, comma separated
HUB_ALLOWED_ORIGINS=https://console.example.com
# How often to sync with the cloud while it's reachable (ms)
HUB_POLL_MS=5000

# TLS certificate for the hub's name (required when the console is served over HTTPS)
HUB_TLS_CERT=
HUB_TLS_KEY=
