{
  "name": "@rms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx src/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@rms/contracts": "workspace:*",
    "@rms/domain": "workspace:*",
    "dotenv": "^16.4.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2"
  }
}
