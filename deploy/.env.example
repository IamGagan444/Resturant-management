# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env ON THE SERVER; never commit it.
# Generate each secret with:  openssl rand -base64 48

# ── Addresses (A records → the server's Elastic IP) ──
CUSTOMER_HOST=restro.gaganpallai.in
CONSOLE_HOST=console.restro.gaganpallai.in
API_HOST=api.restro.gaganpallai.in
# Let's Encrypt account email (expiry notices)
ACME_EMAIL=

# ── Secrets ──
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# ── Super admin (created on first deploy; password ≥ 12 chars) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Menu photos in S3 (same values as your PC's .env) ──
# The region in S3_PUBLIC_URL must be the bucket's region (e.g. ap-south-2 = Hyderabad), or photo links break.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=ap-south-2
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://<bucket>.s3.ap-south-2.amazonaws.com

# ── Off-server database backups (optional; a PRIVATE bucket, not the photo bucket) ──
BACKUP_S3_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=ap-south-1
