# HTTPS certificates are issued and renewed automatically (Let's Encrypt) for each host below.
# Hosts come from deploy/.env.
{
	email {$ACME_EMAIL}
}

# Security headers for every host. HSTS: browsers only ever use HTTPS here.
(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

# Guest app (the address printed in table QR codes)
{$CUSTOMER_HOST} {
	import secure_headers
	encode zstd gzip
	reverse_proxy customer:3000
}

# Staff console: static files; pages are folders (trailingSlash export)
{$CONSOLE_HOST} {
	import secure_headers
	# static app: no framing; source maps are never published
	header X-Frame-Options "DENY"
	header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	@sourcemaps path *.map
	respond @sourcemaps 404
	root * /srv/console
	# the service worker must never be cached, or devices keep an old app
	header /sw.js Cache-Control "no-cache"
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html {path}.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# API + live updates (WebSocket upgrades are proxied automatically)
{$API_HOST} {
	import secure_headers
	reverse_proxy api:4000
}
