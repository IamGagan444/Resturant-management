# Copy to .env and fill in. Never commit .env.

# Database / cache (match docker-compose.yml)
DATABASE_URL=postgresql://rms:rms@localhost:5432/rms?schema=public
REDIS_URL=redis://localhost:6379

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# 32-byte base64 key used to encrypt per-hotel Razorpay secrets at rest
ENCRYPTION_KEY=change-me

# Menu photos (resized to WebP on upload): "local" = files under UPLOAD_DIR served by the API; "s3" = AWS S3 / Cloudflare R2.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# For STORAGE_DRIVER=s3 (all required except S3_ENDPOINT). Use an IAM user limited to this bucket.
# AWS: leave S3_ENDPOINT empty. R2/MinIO: set it, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL objects are served from, e.g. https://<bucket>.s3.ap-south-1.amazonaws.com or a CloudFront domain
S3_PUBLIC_URL=

# Local dev only: fake UPI gateway so the pay flow works without Razorpay keys. Refused in production.
PAYMENTS_MOCK=true

# URLs
API_URL=http://localhost:4000
CUSTOMER_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001

# Seed super admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
