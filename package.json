{
  "name": "rms",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @rms/db generate",
    "db:migrate": "pnpm --filter @rms/db migrate",
    "db:deploy": "pnpm --filter @rms/db migrate:deploy",
    "db:seed": "pnpm --filter @rms/db seed",
    "e2e": "pnpm --filter @rms/e2e e2e",
    "hub": "pnpm --filter @rms/hub start"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
